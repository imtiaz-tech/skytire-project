// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

enum Role {
  USER
  ADMIN
  DEFAULT_USER
}

model User {
  id                  Int       @id @default(autoincrement())
  memberId            Int       @unique
  name                String
  email               String    @unique
  password            String
  role                Role      @default(DEFAULT_USER)
  resetPasswordToken  String?
  resetPasswordExpire DateTime?
  token               String?
  tokenExpire         DateTime?
  isActive            Boolean   @default(true)
  isSubscribed        Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  devices             Device[]

  @@index([email])
  @@index([memberId])
}

model Device {
  id             Int       @id @default(autoincrement())
  visitorId      String    @unique
  isBanned       Boolean   @default(false)
  bannedAt       DateTime?

  browserName    String?
  browserVersion String?
  os             String?
  device         String?
  ipAddress      String?
  city           String?
  country        String?
  vpnDetected    Boolean   @default(false)
  proxyDetected  Boolean   @default(false)
  botDetected    Boolean   @default(false)
  incognito      Boolean   @default(false)
  suspectScore   Float     @default(0)
  
  firstSeenAt    DateTime?
  lastSeenAt     DateTime?

  userId         Int
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt      DateTime  @default(now())

  @@index([visitorId])
  @@index([userId])
}

enum BrandCategory {
  tire
  wheel
  wire_wheel
  accessory
  bolt_on_wheels
}

model Brand {
  id          String        @id @default(uuid())
  brandName   String
  brandLogo   String
  description String?
  coverPhoto  String?
  category    BrandCategory
  isFeatured  Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  tires       Tire[]

  @@index([brandName])
}

model Tire {
  id          Int                     @id @default(autoincrement())
  name        String
  brand       String?
  brandId     String?
  brandRel    Brand?                  @relation(fields: [brandId], references: [id])
  image       String?
  price       Float?
  sku         String?
  stock       Int?                    @default(0)
  description String?
  embedding   Unsupported("vector(1536)")?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
}

model Session {
  id        String   @id
  sid       String   @unique
  data      String
  expiresAt DateTime
}

model GuestUser {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  createdAt DateTime @default(now())

  @@index([email])
}

