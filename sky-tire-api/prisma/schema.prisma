  stock                 Int               @default(0)
  cost                  Float             @default(0)
  internalShipping      Float             @default(0)
  processingCharges     Float             @default(0)
  margin                Float             @default(0)
  processingAmount      Float             @default(0)
  marginAmount          Float             @default(0)
  netCost               Float             @default(0)
  minimumSalePrice      Float             @default(0)
  salePrice             Float             @default(0)
  mapPrice              Float             @default(0)
  mapPriceHistory       Json?             @default("[]")
  regularPrice          Float             @default(0)
  shippingCost          Float             @default(0)
