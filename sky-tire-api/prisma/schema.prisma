model Accessory {
  id                    String            @id @default(cuid())
  sku                   String            @unique
  alternatePartNumber   String?
  upcNo                 String?
  brandId               String?
  category              String
  productName           String
  status                String            @default("draft")
  slug                  String            @unique
  oldSlugs              String[]          @default([])
  packageInclude        String?
  cost                  Float             @default(1)
  internalShipping      Float             @default(0)
  processingCharges     Float             @default(0)
  margin                Float             @default(0)
  processingAmount      Float             @default(0)
  marginAmount          Float             @default(0)
  netCost               Float             @default(0)
  minimumSalePrice      Float             @default(0)
  salePrice             Float             @default(1)
  mapPrice              Float             @default(0)
  mapPriceHistory       Json?             @default("[]")
  regularPrice          Float?
  shippingCost          Float             @default(0)
  handlingFee           Float             @default(0)
  priceChanged          Float             @default(0)
  sourceId              String?
  stock                 Int               @default(0)
  images                String[]
  video                 String?           // Uploaded product video filename/path
  youtubeUrl            String?           // Optional YouTube video URL
  leftImage             String?
  rightImage            String?
  isFeatured            Boolean           @default(false)
  isVisible             Boolean           @default(true)
  description           String?
  keywords              String?
  metaDescription       String?
  seoTitle              String?
  faqs                  String?           // Rich HTML FAQ content (Jodit)
  tags                  String[]          @default([])
  alsoFoundIn           String[]          @default([])
  specifications        Json?             @default("{}")
  materialHardnessScore Int?
  threadPrecisionScore  Int?
  torqueRetentionScore  Int?
  feedbackScore         Int?
  overallRating         Float             @default(0)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  brand                 Brand?            @relation(fields: [brandId], references: [id])
  source                InventorySource?  @relation(fields: [sourceId], references: [id])

  @@index([sku])
  @@index([slug])
  @@index([category])
  @@index([brandId])
}

enum ShippingCategory {
  TIRE
  WHEEL
  WIRE_WHEEL
  BOLT_ON_WIRE_WHEEL
  ACCESSORY
}

model AccessoryCategory {
  id        String     @id @default(cuid())
  name      String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  shippings Shipping[]
}

model Shipping {
  id                  String             @id @default(cuid())
  category            ShippingCategory
  size                String?
  accessoryCategoryId String?            @unique
  accessoryCategory   AccessoryCategory? @relation(fields: [accessoryCategoryId], references: [id])
  weight              Float
  length              Float
  width               Float
  height              Float
  shippingRate        Float
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@unique([category, size])
  @@index([category])
  @@index([size])
  @@index([accessoryCategoryId])
}

enum CouponDiscountType {
  PERCENTAGE
  FIXED
  FREE_SHIPPING
}

enum CouponAppliesTo {
  ALL
  SPECIFIC_PRODUCTS
  SPECIFIC_BRANDS
  ALL_TIRES
  ALL_WHEELS
  ALL_WIRE_WHEELS
  ALL_BOLT_ON_WIRE_WHEELS
  ALL_BLACK_WALL_TIRES
  ALL_WHITE_WALL_TIRES
  ALL_ACCESSORIES
}

enum CouponStatus {
  ACTIVE
  INACTIVE
}

model Coupon {
  id                String             @id @default(cuid())
  code              String             @unique
  title             String
  automaticInstantRebate Boolean       @default(false)
  discountType      CouponDiscountType
  discountValue     Float
  combineWithOtherCoupons  Boolean            @default(false)
  combineWithFinancing     Boolean            @default(false)
  combineWithFreeShipping  Boolean            @default(false)
  exclusiveCoupon          Boolean            @default(false)
  geographicRestrictions   String[]           @default([])
  appliesTo         CouponAppliesTo[]  @default([])
  productIds        String[]           @default([])
  brandIds          String[]           @default([])
  productSelections Json               @default("{}")
  brandSelections   Json               @default("{}")
  minQuantity       Int?
  minOrderPrice     Float?
  userUsageLimit    Int?
  couponUsageLimit  Int?
  startDate         DateTime
  endDate           DateTime?
  status            CouponStatus       @default(ACTIVE)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([code])
  @@index([status])
}

enum PromoBarLinkType {
  INTERNAL
  EXTERNAL
}

model PromoBarSettings {
  id            String   @id @default("global")
  autoplayDelay Int      @default(3000)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model PromoBar {
  id           String           @id @default(cuid())
  text         String
  boldText     String
  bgColor      String           @default("#f2f3ee")
  textColor    String           @default("black")
  boldColor    String           @default("black")
  link         String
  linkType     PromoBarLinkType @default(INTERNAL)
  openInNewTab Boolean          @default(false)
  isActive     Boolean          @default(true)
  order        Int              @default(0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([order])
  @@index([isActive])
}

model RotatorSettings {
  id                String   @id @default("global")
  bgGradientStart   String   @default("#1a1d22")
  bgGradientMiddle  String   @default("#777c8e")
  bgGradientEnd     String   @default("#1a1d22")
  borderColor       String   @default("#0552c0")
  textColor         String   @default("#ffffff")
  glowColor         String   @default("#d1d8f1")
  animationDuration Float    @default(1)
  animationCurve    String   @default("0.68, -0.55, 0.265, 1.55")
  stayDuration      Float    @default(3.8)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model RotatorHeadline {
  id        String   @id @default(cuid())
  title     String
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
  @@index([isActive])
}

model BannerSettings {
  id                  String    @id @default("global")
  backgroundImage     String    @default("")
  countdownEndDate    DateTime?
  countdownText       String    @default("ENDS IN...")
  headlineSegments    Json      @default("[]")
  subheadlineSegments Json      @default("[]")
  buttonColor         String    @default("#184b99")
  buttonText          String    @default("Shop Tires and Wheels")
  ratingValue         Float     @default(4.8)
  ratingText          String    @default("Rated by verified customers")
  ratingTextColor     String    @default("#ffffff")
  ratingBgColor       String    @default("rgba(0, 0, 0, 0.6)")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

enum PriceMatchProductType {
  TIRE
  WHEEL
  WIRE_WHEEL
  BOLT_ON_WIRE_WHEEL
  ACCESSORY
}

model PriceMatchQuery {
  id              String                @id @default(cuid())
  productId       String
  productType     PriceMatchProductType
  competitorURL   String
  competitor      String
  competitorPrice String
  fullName        String
  email           String
  phone           String
  zipCode         String
  isRead          Boolean               @default(false)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([productId, productType])
  @@index([fullName])
  @@index([email])
  @@index([competitor])
  @@index([createdAt])
  @@index([isRead])
}

model EmailTemplate {
  id          String   @id @default(cuid())
  name        String
  subject     String
  html        String   @db.Text
  designJson  Json
  createdById Int?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
  @@index([createdAt])
}

enum CompetitorPriceUpdateType {
  SALE
  REGULAR
}

/** Audit log for competitor pricing bulk sale/regular updates */
model CompetitorPriceUpdate {
  id            String                     @id @default(cuid())
  productId     String
  productType   String                     @default("TIRE") // TIRE | WHEEL | WIRE_WHEEL | BOLT_ON_WIRE_WHEEL | ACCESSORY
  sku           String?
  brand         String?
  model         String?
  productName   String?
  cost          Float                      @default(0)
  salePrice     Float                      @default(0)
  mapPrice      Float                      @default(0)
  regularPrice  Float                      @default(0)
  stock         Int                        @default(0)
  previousPrice Float                      @default(0)
  updatedPrice  Float                      @default(0)
  competitor    String?
  priceType     CompetitorPriceUpdateType
  createdAt     DateTime                   @default(now())

  @@index([priceType, createdAt])
  @@index([productType, priceType, createdAt])
  @@index([productId])
  @@index([createdAt])
}

/** Singleton-style last run summary for Update Inventory */
model InventoryUpdateSummary {
  id               String   @id @default(cuid())
  updatedProducts  Json     @default("[]")
  notFoundProducts Json     @default("[]")
  inventoryType    String?
  sourceName       String?
  uploadColumns    Json     @default("[]")
  timestamp        DateTime @default(now())
  createdById      Int?
  createdBy        User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([timestamp])
}

enum ChatSender {
  VISITOR
  ADMIN
}

model ChatConversation {
  id        String        @id @default(cuid())
  name      String
  email     String
  phone     String
  isRead    Boolean       @default(false)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]

  @@index([isRead])
  @@index([email])
  @@index([updatedAt])
  @@index([name])
}

model ChatMessage {
  id             String           @id @default(cuid())
  conversationId String
  sender         ChatSender
  body           String           @db.Text
  createdAt      DateTime         @default(now())
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

/// Category landing-page FAQs (one rich HTML document per category)
model MainPageFaq {
  id        String   @id @default(cuid())
  category  String   @unique // tires | white_wall_tires | wheels | wire_wheels | bolt_on_wire_wheels | accessories
  content   String?  @db.Text // Rich HTML FAQ content (Jodit)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
}

