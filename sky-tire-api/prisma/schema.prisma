generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

model User {
  id                  Int       @id @default(autoincrement())
  memberId            Int       @unique
  email               String    @unique
  password            String
  role                Role      @default(DEFAULT_USER)
  resetPasswordToken  String?
  resetPasswordExpire DateTime?
  token               String?
  tokenExpire         DateTime?
  isActive            Boolean   @default(true)
  isSubscribed        Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  name                String
  blogs               Blog[]
  devices             Device[]

  @@index([email])
  @@index([memberId])
}

model Device {
  id             Int       @id @default(autoincrement())
  visitorId      String    @unique
  isBanned       Boolean   @default(false)
  bannedAt       DateTime?
  userId         Int
  createdAt      DateTime  @default(now())
  botDetected    Boolean   @default(false)
  browserName    String?
  browserVersion String?
  city           String?
  country        String?
  device         String?
  firstSeenAt    DateTime?
  incognito      Boolean   @default(false)
  ipAddress      String?
  lastSeenAt     DateTime?
  os             String?
  proxyDetected  Boolean   @default(false)
  vpnDetected    Boolean   @default(false)
  suspectScore   Float     @default(0)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([visitorId])
  @@index([userId])
}

model Brand {
  id          String        @id @default(uuid())
  brandName   String
  brandLogo   String
  category    BrandCategory
  isFeatured  Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  coverPhoto  String?
  description String?
  models      TireModel[]

  @@index([brandName])
}

model Tire {
  id                  String           @id @default(cuid())
  modelId             String
  sku                 String           @unique
  alternatePartNumber String?
  upcNo               String?
  stock               Int              @default(0)
  cost                Float            @default(0)
  salePrice           Float            @default(0)
  regularPrice        Float            @default(0)
  mapPrice            Float            @default(0)
  shippingCost        Float            @default(0)
  handlingFee         Float            @default(0)
  freightCharges      Float            @default(0)
  rebateAvailable     Boolean          @default(false)
  mileageScore        Int?             @default(0)
  tractionScore       Int?             @default(0)
  stabilityScore      Int?             @default(0)
  feedbackScore       Int?             @default(0)
  
  // Fields moved from TireSize
  tireSize            String
  tireWidth           String?
  aspectRatio         String?
  rimDiameter         String?
  loadIndex           String?
  speedRating         String?
  loadRange           String?
  inflationPressure   String?
  tireWeight          String?
  shippingDimensions  String?
  utqg                String?
  seoTitle            String?
  metaDescription     String?
  status              TireStatus @default(ACTIVE)
  vehicleType         VehicleType?
  keywords            String?
  features            String[]
  sidewallCategory    SidewallCategory?
  sidewallDetail      String?
  isActive            Boolean       @default(true)

  model               TireModel @relation(fields: [modelId], references: [id], onDelete: Cascade)
  sources             InventorySource[]
  
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([modelId])
  @@index([sku])
  @@index([tireSize])
}

model InventorySource {
  id        String   @id @default(cuid())
  source    String   @unique
  tires     Tire[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  id        String   @id
  sid       String   @unique
  data      String
  expiresAt DateTime
}

model GuestUser {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  createdAt DateTime @default(now())

  @@index([email])
}

model BlogCategory {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  blogs     Blog[]

  @@index([slug])
}

model Blog {
  id             String       @id @default(uuid())
  blogTitle      String
  slug           String       @unique
  oldSlugs       String[]     @default([])
  featuredImage  String
  blogBody       String
  keywords       String[]     @default([])
  blogStatus     BlogStatus   @default(DRAFT)
  publishedAt    DateTime?
  readingTime    Int          @default(0)
  isFeatured     Boolean      @default(false)
  ctaHeading     String?
  ctaDescription String?
  ctaButtonUrl   String?
  ctaButtonText  String?
  colors         Json?
  sections       Json[]
  categoryId     String
  authorId       Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  authorName     String?
  author         User         @relation(fields: [authorId], references: [id])
  category       BlogCategory @relation(fields: [categoryId], references: [id])

  @@index([slug])
  @@index([categoryId])
  @@index([authorId])
}

model AIPrompt {
  id            String   @id @default(cuid())
  aiKey         String   @unique
  prompt        String
  defaultPrompt String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model TireModel {
  id          String   @id @default(cuid())
  brandId     String
  modelName   String
  images      String[]
  description String?
  season      String?
  performance String?

  // New fields
  treadDesign String?
  runFlat     Boolean  @default(false)
  threePMS    Boolean  @default(false)
  warranty    String?
  treadLife   String?

  brand       Brand      @relation(fields: [brandId], references: [id])
  tires       Tire[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([brandId])
  @@index([modelName])
}

enum SidewallCategory {
  BLACK_WALL
  WHITE_WALL
}

enum VehicleType {
  PASSENGER
  LIGHT_TRUCK
  SUV
  TRUCK
  COMMERCIAL
  PERFORMANCE
  OFF_ROAD
}

enum TireStatus {
  ACTIVE
  INACTIVE
}

enum Role {
  USER
  ADMIN
  DEFAULT_USER
}

enum BrandCategory {
  tire
  wheel
  wire_wheel
  accessory
  bolt_on_wheels
}

enum BlogStatus {
  DRAFT
  PUBLISHED
}
