generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

model User {
  id                  Int       @id @default(autoincrement())
  memberId            Int       @unique
  email               String    @unique
  password            String
  role                Role      @default(DEFAULT_USER)
  resetPasswordToken  String?
  resetPasswordExpire DateTime?
  token               String?
  tokenExpire         DateTime?
  isActive            Boolean   @default(true)
  isSubscribed        Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  name                String
  blogs               Blog[]
  devices             Device[]

  @@index([email])
  @@index([memberId])
}

model Device {
  id             Int       @id @default(autoincrement())
  visitorId      String    @unique
  isBanned       Boolean   @default(false)
  bannedAt       DateTime?
  userId         Int
  createdAt      DateTime  @default(now())
  botDetected    Boolean   @default(false)
  browserName    String?
  browserVersion String?
  city           String?
  country        String?
  device         String?
  firstSeenAt    DateTime?
  incognito      Boolean   @default(false)
  ipAddress      String?
  lastSeenAt     DateTime?
  os             String?
  proxyDetected  Boolean   @default(false)
  vpnDetected    Boolean   @default(false)
  suspectScore   Float     @default(0)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([visitorId])
  @@index([userId])
}

model Brand {
  id          String        @id @default(uuid())
  brandName   String
  brandLogo   String
  category    BrandCategory
  isFeatured  Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  coverPhoto  String?
  description String?
  models      TireModel[]
  wheels      Wheel[]
  wireWheels  WireWheel[]
  boltOnWireWheels BoltOnWireWheel[]
  accessories Accessory[]

  @@index([brandName])
}

model Tire {
  id                  String           @id @default(cuid())
  modelId             String
  sku                 String?           @unique
  alternatePartNumber String?
  upcNo               String?
  stock               Int              @default(0)
  cost                Float            @default(0)
  internalShipping    Float            @default(0)
  processingCharges   Float            @default(0)
  margin              Float            @default(0)
  processingAmount    Float            @default(0)
  marginAmount        Float            @default(0)
  netCost             Float            @default(0)
  salePrice           Float            @default(0)
  regularPrice        Float            @default(0)
  mapPrice            Float            @default(0)
  shippingCost        Float            @default(0)
  handlingFee         Float            @default(0)
  freightCharges      Float            @default(0)
  rebateAvailable     Boolean          @default(false)
  mileageScore        Int?             @default(0)
  tractionScore       Int?             @default(0)
  stabilityScore      Int?             @default(0)
  feedbackScore       Int?             @default(0)
  
  // Fields moved from TireSize
  tireSize            String?
  tireWidth           String?
  aspectRatio         String?
  rimDiameter         String?
  loadIndex           String?
  speedRating         String?
  loadRange           String?
  inflationPressure   String?
  tireWeight          String?
  shippingDimensions  String?
  utqg                String?
  seoTitle            String?
  metaDescription     String?
  status              TireStatus @default(ACTIVE)
  vehicleType         VehicleType?
  keywords            String?
  features            String[]
  sidewallCategory    SidewallCategory?
  sidewallDetail      String?
  publishStatus       PublishStatus @default(PUBLISHED)
  isActive            Boolean       @default(true)

  model               TireModel @relation(fields: [modelId], references: [id], onDelete: Cascade)
  sources             InventorySource[]
  
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([modelId])
  @@index([sku])
  @@index([tireSize])
}

model InventorySource {
  id        String   @id @default(cuid())
  source    String   @unique
  tires     Tire[]
  wheels    Wheel[]
  wireWheels WireWheel[]
  boltOnWireWheels BoltOnWireWheel[]
  accessories Accessory[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  id        String   @id
  sid       String   @unique
  data      String
  expiresAt DateTime
}

model GuestUser {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  createdAt DateTime @default(now())

  @@index([email])
}

model BlogCategory {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  blogs     Blog[]

  @@index([slug])
}

model Blog {
  id             String       @id @default(uuid())
  blogTitle      String
  slug           String       @unique
  oldSlugs       String[]     @default([])
  featuredImage  String
  blogBody       String
  keywords       String[]     @default([])
  blogStatus     BlogStatus   @default(DRAFT)
  publishedAt    DateTime?
  readingTime    Int          @default(0)
  isFeatured     Boolean      @default(false)
  ctaHeading     String?
  ctaDescription String?
  ctaButtonUrl   String?
  ctaButtonText  String?
  colors         Json?
  sections       Json[]
  categoryId     String
  authorId       Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  authorName     String?
  author         User         @relation(fields: [authorId], references: [id])
  category       BlogCategory @relation(fields: [categoryId], references: [id])

  @@index([slug])
  @@index([categoryId])
  @@index([authorId])
}

model AIPrompt {
  id            String   @id @default(cuid())
  aiKey         String   @unique
  prompt        String
  defaultPrompt String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model TireModel {
  id          String   @id @default(cuid())
  brandId     String
  modelName   String
  images      String[]
  description String?
  season      String?
  performance String?

  // New fields
  treadDesign String?
  runFlat     Boolean  @default(false)
  threePMS    Boolean  @default(false)
  warranty    String?
  treadLife   String?

  brand       Brand      @relation(fields: [brandId], references: [id])
  tires       Tire[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([brandId])
  @@index([modelName])
}

enum SidewallCategory {
  BLACK_WALL
  WHITE_WALL
}

enum VehicleType {
  PASSENGER
  LIGHT_TRUCK
  SUV
  TRUCK
  COMMERCIAL
  PERFORMANCE
  OFF_ROAD
}

enum TireStatus {
  ACTIVE
  INACTIVE
}

enum Role {
  USER
  ADMIN
  DEFAULT_USER
}

enum BrandCategory {
  tire
  wheel
  wire_wheel
  accessory
  bolt_on_wheels
}

enum BlogStatus {
  DRAFT
  PUBLISHED
}

enum PublishStatus {
  PUBLISHED
  DRAFT
}

model Wheel {
  id                   String            @id @default(cuid())
  sku                  String            @unique
  productName          String
  brandId              String?
  brandVariant         String            @default("")
  displayStyleNo       String?
  finish               String?
  slug                 String            @unique
  oldSlugs             String[]          @default([])
  wheelSize            String
  
  // Model details directly inside Wheel table
  style                String?           // E.g., Luxury, Off-road, Sport, Mesh
  
  // New requested fields
  alternatePartNumber  String?
  upcNo                String?
  lugCount             Int?

  // Split measurement fields
  boltPatternInches    String?
  boltPatternMM        String?
  loadRatingKg         String?
  loadRatingLbs        String?

  offset               String
  backSpacing          Float?
  centerBore           String?
  shippingWeight       String
  images               String[]          // Array of paths/URLs uploaded directly to the server
  description          String?
  invOrderType         String?
  stock                Int               @default(0)
  cost                 Float             @default(0)
  salePrice            Float             @default(0)
  regularPrice         Float             @default(0)
  mapPrice             Float             @default(0)
  shippingCost         Float             @default(0)
  handlingFee          Float             @default(0)
  isFeatured           Boolean           @default(false)
  keywords             String?
  metaDescription      String?
  seoTitle             String?
  isVisible            Boolean           @default(true)
  category             String            @default("none")
  status               String            @default("draft") // draft or published
  isActive             Boolean           @default(true)  // active or inactive

  // Sky Wheel Score (0-10)
  finishDurabilityScore   Int?            @default(0)
  fitmentPrecisionScore   Int?            @default(0)
  impactResistanceScore   Int?            @default(0)
  feedbackScore           Int?            @default(0)

  // Relations setup
  brand                Brand?            @relation(fields: [brandId], references: [id])
  sources              InventorySource[] // Implicit Many-to-Many with your existing table

  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@index([brandId])
  @@index([sku])
}

model WireWheel {
  id                    String            @id @default(cuid())
  images                String[]
  knockOffs             Json?             // Structure: image, name, price, chipOption, chips[] (image, name)
  floatingCaps          Json?             // Structure: image, name, price
  name                  String
  description           String?
  sku                   String            @unique
  size                  String
  finish                String?
  countryOfOrigin       String?
  brandId               String?
  sourceId              String?
  stock                 Int               @default(0)
  cost                  Float             @default(0)
  salePrice             Float             @default(0)
  mapPrice              Float             @default(0)
  regularPrice          Float             @default(0)
  shippingCost          Float             @default(0)
  handlingFee           Float             @default(0)
  packageInclude        String?
  knockOffOption        String?
  options               String?
  boltPattern           String?
  accessories           String?
  backSpacing           Float?
  spoke                 Int?
  spokeStyle            String?
  offset                String?
  staggeredFitment      Boolean           @default(false)
  keywords              String?
  seoTitle              String?
  metaDescription       String?
  
  // Wire Wheel Scores (0-10)
  platingDepthScore     Int?              @default(0)
  sealingIntegrityScore Int?              @default(0)
  spokeTensionScore     Int?              @default(0)
  feedbackScore         Int?              @default(0)

  status                String            @default("draft") // draft or published
  isVisible             Boolean           @default(true)
  isActive              Boolean           @default(true)
  slug                  String            @unique
  oldSlugs              String[]          @default([])
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  brand                 Brand?            @relation(fields: [brandId], references: [id])
  source                InventorySource?  @relation(fields: [sourceId], references: [id])

  @@index([brandId])
  @@index([sku])
  @@index([slug])
}

model BoltOnWireWheel {
  id                    String            @id @default(cuid())
  images                String[]
  knockOffs             Json?             // Structure: image, name, price, chipOption, chips[] (image, name)
  floatingCaps          Json?             // Structure: image, name, price
  name                  String
  description           String?
  sku                   String            @unique
  size                  String
  finish                String?
  countryOfOrigin       String?
  brandId               String?
  sourceId              String?
  stock                 Int               @default(0)
  cost                  Float             @default(0)
  salePrice             Float             @default(0)
  mapPrice              Float             @default(0)
  regularPrice          Float             @default(0)
  shippingCost          Float             @default(0)
  handlingFee           Float             @default(0)
  packageInclude        String?
  knockOffOption        String?
  options               String?
  boltPattern           String?
  accessories           String?
  backSpacing           Float?
  spoke                 Int?
  spokeStyle            String?
  offset                String?
  staggeredFitment      Boolean           @default(false)
  keywords              String?
  seoTitle              String?
  metaDescription       String?
  
  // Wire Wheel Scores (0-10)
  platingDepthScore     Int?              @default(0)
  sealingIntegrityScore Int?              @default(0)
  spokeTensionScore     Int?              @default(0)
  feedbackScore         Int?              @default(0)

  status                String            @default("draft") // draft or published
  isVisible             Boolean           @default(true)
  isActive              Boolean           @default(true)
  slug                  String            @unique
  oldSlugs              String[]          @default([])
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  brand                 Brand?            @relation(fields: [brandId], references: [id])
  source                InventorySource?  @relation(fields: [sourceId], references: [id])

  @@index([brandId])
  @@index([sku])
  @@index([slug])
}

model Accessory {
  id                    String            @id @default(cuid())
  sku                   String            @unique
  brandId               String?
  category              String
  productName           String
  status                String            @default("draft")
  slug                  String            @unique
  oldSlugs              String[]          @default([])
  packageInclude        String?
  cost                  Float             @default(1)
  salePrice             Float             @default(1)
  mapPrice              Float             @default(0)
  mapPriceHistory       Json?             @default("[]")
  regularPrice          Float?
  shippingCost          Float             @default(0)
  handlingFee           Float             @default(0)
  priceChanged          Float             @default(0)
  sourceId              String?
  stock                 Int               @default(0)
  images                String[]
  leftImage             String?
  rightImage            String?
  isFeatured            Boolean           @default(false)
  isVisible             Boolean           @default(true)
  description           String?
  keywords              String?
  metaDescription       String?
  seoTitle              String?
  specifications        Json?             @default("{}")
  materialHardnessScore Int?
  threadPrecisionScore  Int?
  torqueRetentionScore  Int?
  feedbackScore         Int?
  overallRating         Float             @default(0)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  brand                 Brand?            @relation(fields: [brandId], references: [id])
  source                InventorySource?  @relation(fields: [sourceId], references: [id])

  @@index([sku])
  @@index([slug])
  @@index([category])
  @@index([brandId])
}
